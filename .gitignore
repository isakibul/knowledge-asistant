# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Test, coverage, type-checking, and linting artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Build and packaging outputs
build/
dist/
*.egg-info/
.eggs/

# Local data and database files
documents/*
!documents/.gitkeep
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
